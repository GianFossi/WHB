<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Ganfoss</Authors>
    <Description>Command-line runner and report generator for WHB/PGC thermal and hydraulic calculations.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyName>whb</AssemblyName>
    <RootNamespace>Whb.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Ahead-of-time compile the hot paths into the published image: the calculation is
         now short enough that JIT warm-up is a visible share of a run. Build setting only,
         no new dependency and no effect on results. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\DOC_correlazioni_e_problematiche.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\*.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Json.fs" />
    <Compile Include="OutputPaths.fs" />
    <Compile Include="PhaseLogger.fs" />
    <Compile Include="Preflight.fs" />
    <Compile Include="Progress.fs" />
    <Compile Include="PdsComparison.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whb.Core\Whb.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.301" />
  </ItemGroup>

</Project>
