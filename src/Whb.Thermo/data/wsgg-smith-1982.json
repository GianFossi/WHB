  "schemaVersion": "1.0",
  "model": "Smith, Shen & Friedman (1982) weighted-sum-of-gray-gases, 3 gray + 1 clear",
  "status": "POPULATED",
  "formulation": [
    "eps   = SUM_i a_i(T) * (1 - exp(-k_i * p * L))",
    "a_i(T)= SUM_j b[i][j] * T^(j-1)          (cubic, j = 1..4, T in K)",
    "a_0   = 1 - SUM_i a_i                    (clear-gas weight)",
    "k     = -ln(1 - eps) / L                 (Beer-Lambert absorption coefficient)",
    "p = P_H2O + P_CO2 [atm], L = mean beam length [m], k_i in 1/(atm*m)"
  ],
