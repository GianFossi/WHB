    <Compile Include="Solvers\TwoPhase.fs" />
    <Compile Include="Components\Equipment\Drum.fs" />
    <Compile Include="Components\Equipment\Bundle.fs" />
    <Compile Include="Components\Piping\Piping.fs" />
    <Compile Include="Components\Equipment\Valve.fs" />
    <Compile Include="Components\Equipment\Bypass.fs" />
    <Compile Include="Loads\Vibration.fs" />
    <Compile Include="Options\Types.fs" />
    <Compile Include="Components\Equipment\BundleGeometry.fs" />
    <Compile Include="Solvers\BundleSolver.Contracts.fs" />
