<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Ganfoss</Authors>
    <Description>Thermal, hydraulic and diagnostic calculation library for fire-tube WHB/PGC equipment.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);3370;FS0064;FS1182;FS0025</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\DOC_correlazioni_e_problematiche.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\*.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Options\Constants.fs" />
    <Compile Include="Options\ProgressModel.fs" />
    <Compile Include="Materials\SteamIF97.fs" />
    <Compile Include="Materials\GasProps.fs" />
    <Compile Include="Options\Shift.fs" />
    <Compile Include="Materials\Materials.fs" />
    <Compile Include="Process\Claus.fs" />
    <Compile Include="Process\Sulphur.fs" />
    <Compile Include="Process\SulphurCondenser.fs" />
