<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Ganfoss</Authors>
    <Description>Component, equipment, piping and material-property models for WHB packages.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Common\Bom.fs" />
    <Compile Include="Common\Metrics.fs" />
    <Compile Include="Materials\MaterialCatalog.fs" />
    <Compile Include="Components\Geometry\CylinderGeometry.fs" />
    <Compile Include="Components\Geometry\PipeGeometry.fs" />
    <Compile Include="Components\Geometry\TransitionConeGeometry.fs" />
    <Compile Include="Components\Geometry\HemisphericalHeadGeometry.fs" />
    <Compile Include="Components\Geometry\EllipticalHeadGeometry.fs" />
    <Compile Include="Components\Geometry\TorisphericalHeadGeometry.fs" />
    <Compile Include="Components\Geometry\TubesheetProfile.fs" />
    <Compile Include="Components\Geometry\TubesheetGeometry.fs" />
    <Compile Include="Components\Geometry\BaffleGeometry.fs" />
    <Compile Include="Components\Geometry\CylindricalLinerGeometry.fs" />
    <Compile Include="Components\Geometry\ImpingementPlateGeometry.fs" />
    <Compile Include="Components\Geometry\NozzleGeometry.fs" />
    <Compile Include="Components\Geometry\PipeElbowGeometry.fs" />
    <Compile Include="Components\Geometry\ConicalReducerGeometry.fs" />
    <Compile Include="Components\Geometry\RectangularShellGeometry.fs" />
    <Compile Include="Components\Geometry\PorousPadGeometry.fs" />
    <Compile Include="Components\Geometry.fs" />
    <Compile Include="Components\ComponentModel.fs" />
    <Compile Include="Components\PressureParts.fs" />
    <Compile Include="Components\Piping.fs" />
    <Compile Include="Equipment\Assemblies.fs" />
    <Compile Include="Interop\WhbCoreContracts.fs" />
    <Compile Include="Equipment\Package.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.301" />
  </ItemGroup>

</Project>
